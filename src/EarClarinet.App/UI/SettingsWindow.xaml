<Window x:Class="EarClarinet.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EarClarinet Settings"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <!-- Position picker dot: filled with the accent when selected. -->
        <Style x:Key="PositionDot" TargetType="RadioButton">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Dot"
                                Width="14"
                                Height="14"
                                CornerRadius="3"
                                Background="{DynamicResource DimTextBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
        <StackPanel Margin="24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Image x:Name="HeaderLogo"
                       Height="20"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="Collapsed" />
                <TextBlock Text="EarClarinet Settings"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Appearance"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <RadioButton x:Name="DarkThemeRadio"
                             Content="Dark"
                             GroupName="Theme"
                             Checked="OnThemeChanged"
                             Foreground="{DynamicResource TextBrush}" />
                <RadioButton x:Name="LightThemeRadio"
                             Content="Light"
                             GroupName="Theme"
                             Margin="24,0,0,0"
                             Checked="OnThemeChanged"
                             Foreground="{DynamicResource TextBrush}" />
            </StackPanel>

            <TextBlock Text="Accent color"
                       FontWeight="SemiBold"
                       Margin="0,10,0,4" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AccentTeal" GroupName="Accent" Tag="#FF4EC9B0" Checked="OnAccentChanged" ToolTip="Teal">
                    <Rectangle Width="18" Height="18" RadiusX="9" RadiusY="9" Fill="#FF4EC9B0" />
                </RadioButton>
                <RadioButton x:Name="AccentBlue" GroupName="Accent" Tag="#FF4E8DF7" Checked="OnAccentChanged" ToolTip="Blue" Margin="10,0,0,0">
                    <Rectangle Width="18" Height="18" RadiusX="9" RadiusY="9" Fill="#FF4E8DF7" />
                </RadioButton>
                <RadioButton x:Name="AccentPurple" GroupName="Accent" Tag="#FF9B6DF5" Checked="OnAccentChanged" ToolTip="Purple" Margin="10,0,0,0">
                    <Rectangle Width="18" Height="18" RadiusX="9" RadiusY="9" Fill="#FF9B6DF5" />
                </RadioButton>
                <RadioButton x:Name="AccentPink" GroupName="Accent" Tag="#FFF56DA8" Checked="OnAccentChanged" ToolTip="Pink" Margin="10,0,0,0">
                    <Rectangle Width="18" Height="18" RadiusX="9" RadiusY="9" Fill="#FFF56DA8" />
                </RadioButton>
                <RadioButton x:Name="AccentOrange" GroupName="Accent" Tag="#FFF59E4E" Checked="OnAccentChanged" ToolTip="Orange" Margin="10,0,0,0">
                    <Rectangle Width="18" Height="18" RadiusX="9" RadiusY="9" Fill="#FFF59E4E" />
                </RadioButton>
                <RadioButton x:Name="AccentGreen" GroupName="Accent" Tag="#FF6DC85A" Checked="OnAccentChanged" ToolTip="Green" Margin="10,0,0,0">
                    <Rectangle Width="18" Height="18" RadiusX="9" RadiusY="9" Fill="#FF6DC85A" />
                </RadioButton>
                <RadioButton x:Name="AccentRed" GroupName="Accent" Tag="#FFF5605A" Checked="OnAccentChanged" ToolTip="Red" Margin="10,0,0,0">
                    <Rectangle Width="18" Height="18" RadiusX="9" RadiusY="9" Fill="#FFF5605A" />
                </RadioButton>
            </StackPanel>

            <TextBlock Text="Global Hotkey"
                       FontWeight="SemiBold"
                       Margin="0,16,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HotkeyBox"
                         Grid.Column="0"
                         FontSize="14"
                         IsReadOnly="True"
                         Padding="6,4"
                         Background="{DynamicResource InputBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         GotKeyboardFocus="OnHotkeyBoxGotFocus"
                         LostKeyboardFocus="OnHotkeyBoxLostFocus"
                         PreviewKeyDown="OnHotkeyBoxPreviewKeyDown" />
                <Button x:Name="ClearHotkeyButton"
                        Grid.Column="1"
                        Content="Clear"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Click="OnClearHotkeyClicked"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        Foreground="{DynamicResource TextBrush}" />
            </Grid>
            <TextBlock x:Name="HotkeyHint"
                       Text="Click the box and press a key combination (e.g. Ctrl+Alt+M)."
                       FontSize="11"
                       Foreground="{DynamicResource DimTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,16" />

            <TextBlock Text="Position"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>

                <RadioButton x:Name="SideTopLeft" Style="{StaticResource PositionDot}" GroupName="Side" Tag="TopLeft" Grid.Row="0" Grid.Column="0" ToolTip="Top left" Checked="OnSideChanged" />
                <RadioButton x:Name="SideTopCenter" Style="{StaticResource PositionDot}" GroupName="Side" Tag="TopCenter" Grid.Row="0" Grid.Column="1" ToolTip="Top center" Checked="OnSideChanged" />
                <RadioButton x:Name="SideTopRight" Style="{StaticResource PositionDot}" GroupName="Side" Tag="TopRight" Grid.Row="0" Grid.Column="2" ToolTip="Top right" Checked="OnSideChanged" />
                <RadioButton x:Name="SideLeft" Style="{StaticResource PositionDot}" GroupName="Side" Tag="Left" Grid.Row="1" Grid.Column="0" ToolTip="Left edge" Checked="OnSideChanged" />
                <Rectangle Grid.Row="1" Grid.Column="1" Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource DimTextBrush}" Opacity="0.25" />
                <RadioButton x:Name="SideRight" Style="{StaticResource PositionDot}" GroupName="Side" Tag="Right" Grid.Row="1" Grid.Column="2" ToolTip="Right edge" Checked="OnSideChanged" />
                <RadioButton x:Name="SideBottomLeft" Style="{StaticResource PositionDot}" GroupName="Side" Tag="BottomLeft" Grid.Row="2" Grid.Column="0" ToolTip="Bottom left" Checked="OnSideChanged" />
                <RadioButton x:Name="SideBottomCenter" Style="{StaticResource PositionDot}" GroupName="Side" Tag="BottomCenter" Grid.Row="2" Grid.Column="1" ToolTip="Bottom center" Checked="OnSideChanged" />
                <RadioButton x:Name="SideBottomRight" Style="{StaticResource PositionDot}" GroupName="Side" Tag="BottomRight" Grid.Row="2" Grid.Column="2" ToolTip="Bottom right" Checked="OnSideChanged" />
            </Grid>

            <TextBlock Text="Distance from screen edge"
                       FontWeight="SemiBold"
                       Margin="0,10,0,2" />
            <Slider x:Name="EdgeOffsetSlider"
                    Minimum="0"
                    Maximum="80"
                    ValueChanged="OnEdgeOffsetChanged" />

            <TextBlock Text="Overlay opacity"
                       FontWeight="SemiBold"
                       Margin="0,10,0,2" />
            <Slider x:Name="FocusedOpacitySlider"
                    Minimum="0.3"
                    Maximum="1.0"
                    SmallChange="0.05"
                    LargeChange="0.1"
                    ValueChanged="OnFocusedOpacityChanged" />

            <TextBlock Text="Dimmed bars opacity"
                       FontWeight="SemiBold"
                       Margin="0,10,0,2" />
            <Slider x:Name="DimOpacitySlider"
                    Minimum="0.05"
                    Maximum="0.9"
                    SmallChange="0.05"
                    LargeChange="0.1"
                    ValueChanged="OnDimOpacityChanged" />

            <TextBlock Text="Monitor"
                       FontWeight="SemiBold"
                       Margin="0,14,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <RadioButton x:Name="MonitorCursorRadio"
                             Content="Monitor with cursor"
                             GroupName="Monitor"
                             Checked="OnMonitorModeChanged"
                             Foreground="{DynamicResource TextBrush}" />
                <RadioButton x:Name="MonitorFixedRadio"
                             Content="Fixed monitor"
                             GroupName="Monitor"
                             Margin="24,0,0,0"
                             Checked="OnMonitorModeChanged"
                             Foreground="{DynamicResource TextBrush}" />
            </StackPanel>
            <ComboBox x:Name="MonitorsCombo"
                      Margin="0,0,0,4"
                      Background="{DynamicResource InputBrush}"
                      BorderBrush="{DynamicResource InputBorderBrush}"
                      Foreground="{DynamicResource TextBrush}"
                      SelectionChanged="OnMonitorsComboChanged" />

            <CheckBox x:Name="LaunchAtStartupCheck"
                      Content="Launch EarClarinet with Windows"
                      Margin="0,10,0,0"
                      Checked="OnLaunchAtStartupChanged"
                      Unchecked="OnLaunchAtStartupChanged"
                      Foreground="{DynamicResource TextBrush}" />

            <CheckBox x:Name="ShowHintsCheck"
                      Content="Show shortcut hints (TAB / M)"
                      Margin="0,8,0,0"
                      Checked="OnShowHintsChanged"
                      Unchecked="OnShowHintsChanged"
                      Foreground="{DynamicResource TextBrush}" />

            <TextBlock x:Name="VersionFooter"
                       FontSize="10"
                       Foreground="{DynamicResource DimTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
