<Window x:Class="EarClarinet.App.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About EarClarinet"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="28,24" HorizontalAlignment="Center">
        <Image x:Name="AboutLogo"
               Width="64"
               Height="64"
               HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <TextBlock x:Name="AboutTitle"
                   Text="EarClarinet"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0" />

        <TextBlock x:Name="AboutVersion"
                   Text="Version 0.1.0"
                   FontSize="12"
                   Foreground="{DynamicResource DimTextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" />

        <TextBlock Text="Per-app volume mixer for Windows."
                   FontSize="12"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0" />

        <TextBlock Text="MIT License — EarClarinet contributors"
                   FontSize="11"
                   Foreground="{DynamicResource DimTextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <TextBlock Text="Support the project:"
                       FontSize="11"
                       Foreground="{DynamicResource DimTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock FontSize="11"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0">
                <Hyperlink x:Name="KoFiLink"
                           NavigateUri="https://ko-fi.com/gatacampestre"
                           RequestNavigate="OnKoFiNavigate"
                           Foreground="{DynamicResource AccentBrush}">
                    ko-fi.com/gatacampestre
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Button Content="Close"
                Width="96"
                Margin="0,18,0,0"
                HorizontalAlignment="Center"
                Padding="8,4"
                Click="OnCloseClicked"
                Background="{DynamicResource InputBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}"
                Foreground="{DynamicResource TextBrush}" />
    </StackPanel>
</Window>
